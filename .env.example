# Environment Configuration for DataSentinel
# Copie este arquivo para .env e preencha com suas credenciais

# ========== Application Settings ==========
ENVIRONMENT=development
LOG_LEVEL=INFO

# ========== Report Configuration ==========
REPORT_OUTPUT_DIR=./reports
REPORT_FORMAT=json  # Options: json, html, csv

# ========== PostgreSQL Configuration ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# ========== SQL Server Configuration ==========
SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=your_database
SQLSERVER_USER=your_user
SQLSERVER_PASSWORD=your_password

# ========== Slack Alerts ==========
ENABLE_SLACK_ALERTS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ========== Email Alerts ==========
ENABLE_EMAIL_ALERTS=false
EMAIL_RECIPIENTS=email1@example.com,email2@example.com

# ========== Validation Thresholds ==========
MAX_NULL_PERCENTAGE=5.0
OUTLIER_ZSCORE_THRESHOLD=3.0
